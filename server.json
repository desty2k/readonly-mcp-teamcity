{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.desty2k/teamcity",
  "title": "TeamCity CI/CD",
  "description": "Read-only MCP server for JetBrains TeamCity — builds, configs, logs, tests, agents",
  "websiteUrl": "https://blog.wentland.io/blog/read-only-mcp-server-teamcity/",
  "repository": {
    "url": "https://github.com/desty2k/readonly-mcp-teamcity",
    "source": "github"
  },
  "version": "1.0.0",
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "readonly-mcp-teamcity",
      "version": "1.0.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "TEAMCITY_BASE_URL",
          "description": "TeamCity server base URL (e.g., https://teamcity.example.com)",
          "isRequired": true,
          "format": "string",
          "isSecret": false
        },
        {
          "name": "TEAMCITY_TOKEN",
          "description": "TeamCity REST API bearer token (scope it read-only)",
          "isRequired": true,
          "format": "string",
          "isSecret": true
        }
      ]
    }
  ]
}
