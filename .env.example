# TeamCity connection (required)
# Base URL of the TeamCity server, e.g. https://teamcity.example.com
TEAMCITY_BASE_URL=https://teamcity.example.com
# Bearer token for the REST API. Create one under Profile > Access Tokens;
# set "Permissions scope" to "Limit per project" and pick the Read-only preset.
TEAMCITY_TOKEN=your-bearer-token-here

# HTTP client tuning
TEAMCITY_TIMEOUT=30
TEAMCITY_MAX_RETRIES=3
TEAMCITY_POOL_MAX_CONNECTIONS=20

# Pagination defaults
TEAMCITY_DEFAULT_LIMIT=50
TEAMCITY_MAX_LIMIT=500

# Build-config index refresh interval in seconds (powers fuzzy search)
TEAMCITY_INDEX_REFRESH_INTERVAL=300

# Transport: stdio (default), http, sse
TEAMCITY_TRANSPORT=stdio

# HTTP/SSE transport address. These transports have no authentication:
# keep the loopback default unless something else protects the port.
TEAMCITY_HTTP_HOST=127.0.0.1
TEAMCITY_HTTP_PORT=8080

# Build-log cache: total size cap in bytes and entry lifetime in seconds.
# Logs of running builds are never cached.
TEAMCITY_LOG_CACHE_MAX_BYTES=67108864
TEAMCITY_LOG_CACHE_TTL=300

# Logging: json (default) or text
TEAMCITY_LOG_FORMAT=json
TEAMCITY_LOG_LEVEL=INFO

# --- OpenTelemetry tracing (optional) ---
# Off by default. Requires the `otel` extra: pip install 'readonly-mcp-teamcity[otel]'
# When disabled, the server runs exactly as if OpenTelemetry weren't present.
TEAMCITY_OTEL_ENABLED=false
# Resource service.name reported on every span
TEAMCITY_OTEL_SERVICE_NAME=readonly-mcp-teamcity
# OTLP collector endpoint. Leave unset to fall back to OTEL_EXPORTER_OTLP_ENDPOINT
# (or the protocol default: grpc localhost:4317 / http localhost:4318).
# TEAMCITY_OTEL_ENDPOINT=http://localhost:4317
# OTLP protocol: grpc (default) or http/protobuf
TEAMCITY_OTEL_PROTOCOL=grpc
# Also print spans to stderr — useful for local debugging without a collector
TEAMCITY_OTEL_CONSOLE_EXPORT=false
